---
import "../index.css";
import { Font } from "astro:assets";
import { factions } from "@/data/factions";
import { factionStyles } from "@/data/factionStyles";
import {
	Blocks,
	Calculator,
	Castle,
	ChevronDown,
	Gauge,
	Gem,
	Home,
	ScrollText,
	Sparkles,
	History,
	Swords,
} from "lucide-react";
import { Schema } from "astro-seo-schema";
import type { Thing, WithContext } from "schema-dts";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	socialImageUrl?: string;
	schema?: WithContext<Thing> | WithContext<Thing>[];
	/** Let the page span the full viewport width (wide tables). */
	wide?: boolean;
}

// Site-wide defaults — update these for each new site
const SITE_NAME = "SoC Codex";
const SITE_DESCRIPTION =
	"Songs of Conquest faction codex — compare unit stats between Rana and the Barony of Loth.";

const { url } = Astro;
const {
	title: pageTitle,
	description = SITE_DESCRIPTION,
	noindex = false,
	socialImageUrl,
	schema,
	wide = false,
} = Astro.props;

// Construct uniform title: "Page Title | Site Name" or just "Site Name"
const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : SITE_NAME;

const nav = [
	{ href: "/", label: "Home", Icon: Home },
	{ href: "/compare/", label: "Compare Units", Icon: Swords },
	{ href: "/calculator/", label: "Damage Calc", Icon: Calculator },
	{ href: "/buildings/", label: "Buildings", Icon: Blocks },
	{ href: "/spells/", label: "Spells", Icon: Sparkles },
	{ href: "/wielders/", label: "Wielders", Icon: ScrollText },
	{ href: "/artifacts/", label: "Artifacts", Icon: Gem },
	{ href: "/patches/", label: "Patch Notes", Icon: History },
	{ href: "/power-model/", label: "Power Model", Icon: Gauge },
];
const path = url.pathname;

// Factions live in their own menu — seven accent-coloured links crowd the bar.
const factionLinks = factions.map((f) => ({
	href: `/factions/${f.slug}/`,
	label: f.shortName,
	dot: factionStyles[f.name].text,
}));
const activeFaction = factionLinks.find((f) => f.href === path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={url.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <Font cssVariable="--font-cinzel" preload />
    <Font cssVariable="--font-spectral" preload />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:type" content="website" />
    {socialImageUrl && (
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={title} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <Schema item={s} />)
      : <Schema item={schema} />
    )}
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col">
    <header class="border-b border-border/70 bg-background/80 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto max-w-7xl px-4 py-3 flex flex-wrap items-center justify-between gap-3">
        <a href="/" class="font-display text-xl font-bold tracking-wide text-gold">
          SoC <span class="text-foreground">Codex</span>
        </a>
        <nav class="flex flex-wrap items-center gap-1 text-sm">
          {nav.map((item) => {
            const Icon = "Icon" in item ? item.Icon : null;
            return (
              <a
                href={item.href}
                class:list={[
                  "flex items-center gap-1.5 px-3 py-1.5 rounded-md transition-colors hover:bg-accent hover:text-accent-foreground",
                  path === item.href ? "bg-accent text-gold font-semibold" : "text-muted-foreground",
                ]}
              >
                {Icon && <Icon className="h-4 w-4 shrink-0" aria-hidden="true" />}
                {item.label}
              </a>
            );
          })}

          <details class="group relative" data-faction-menu>
            <summary
              class:list={[
                "flex cursor-pointer list-none items-center gap-1.5 rounded-md px-3 py-1.5 transition-colors hover:bg-accent hover:text-accent-foreground [&::-webkit-details-marker]:hidden",
                activeFaction ? "bg-accent text-gold font-semibold" : "text-muted-foreground",
              ]}
            >
              {activeFaction
                ? <span class:list={["h-2 w-2 rounded-full bg-current shrink-0", activeFaction.dot]} aria-hidden="true" />
                : <Castle className="h-4 w-4 shrink-0" aria-hidden="true" />}
              {activeFaction ? activeFaction.label : "Factions"}
              <ChevronDown className="h-3.5 w-3.5 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
            </summary>
            <div class="absolute right-0 z-50 mt-1 min-w-44 rounded-md border border-border bg-card p-1 shadow-strong">
              {factionLinks.map((f) => (
                <a
                  href={f.href}
                  class:list={[
                    "flex items-center gap-2 rounded px-2.5 py-1.5 transition-colors hover:bg-accent hover:text-accent-foreground",
                    f.href === path ? "bg-accent text-gold font-semibold" : "text-muted-foreground",
                  ]}
                >
                  <span class:list={["h-2 w-2 rounded-full bg-current shrink-0", f.dot]} aria-hidden="true" />
                  {f.label}
                </a>
              ))}
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main class:list={["flex-1 mx-auto w-full px-4 py-8", wide ? "max-w-none" : "max-w-7xl"]}>
      <slot />
    </main>

    <script is:inline>
      // Close the faction menu on an outside click or Escape.
      (function () {
        var menu = document.querySelector("[data-faction-menu]");
        if (!menu) return;
        document.addEventListener("click", function (e) {
          if (!menu.contains(e.target)) menu.open = false;
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") menu.open = false;
        });
      })();
    </script>

    <script is:inline>
      // Minimal first-party analytics beacon (see worker/analytics.js).
      if (location.hostname !== "localhost" && !navigator.webdriver) {
        var isNewSession = !sessionStorage.getItem("soc_seen");
        sessionStorage.setItem("soc_seen", "1");
        var beacon =
          "/~/hit?p=" +
          encodeURIComponent(location.pathname) +
          (isNewSession ? "&v=1" : "");
        (navigator.sendBeacon && navigator.sendBeacon(beacon)) ||
          fetch(beacon, { method: "POST", keepalive: true });
      }
    </script>

    <footer class="border-t border-border/70 py-6 text-center text-xs text-muted-foreground">
      Fan-made stat reference for local use. Data &amp; images from the
      <a href="https://songsofconquest.fandom.com/" class="underline hover:text-foreground">Songs of Conquest wiki</a>.
    </footer>
  </body>
</html>
