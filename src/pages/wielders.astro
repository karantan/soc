---
import Layout from "@/layouts/Layout.astro";
import WielderBrowser from "@/components/WielderBrowser";
import ClassPools from "@/components/ClassPools";
---

<Layout
  title="Wielders"
  description="All Songs of Conquest wielders with stats, starting skills, specializations and starting troops, filterable by faction."
  wide
>
  <h1 class="text-3xl font-bold">Wielders</h1>
  <p class="mt-2 mb-6 max-w-3xl text-muted-foreground">
    Every hero in the game with their combat stats, starting skill,
    specialization and starting troops. Filter by faction and click column
    headers to sort. Some entries are incomplete on the wiki (notably Yulan).
  </p>
  <WielderBrowser client:load />

  <section class="mt-12">
    <h2 class="text-2xl font-bold">Class Skill Pools</h2>
    <p class="mt-2 mb-5 max-w-3xl text-muted-foreground">
      The three skills offered at each level-up are drawn from fixed pools
      determined by the wielder's <span class="text-gold">class</span> — not the
      individual wielder. Pools unlock by level bracket, and some skills only
      appear after you've learned their prerequisites, so early picks steer
      later offers. Hover any skill for its effects and requirements.
    </p>
    <ClassPools client:load />
  </section>
</Layout>
