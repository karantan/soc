---
import Layout from "@/layouts/Layout.astro";
import CompareTable from "@/components/CompareTable";
---

<Layout
  title="Compare Units"
  description="Side-by-side sortable comparison of unit stats across all Songs of Conquest factions, with full-stack Power and gold Efficiency scores."
  wide
>
  <h1 class="text-3xl font-bold">Unit Comparison</h1>
  <p class="mt-2 mb-6 max-w-3xl text-muted-foreground">
    All units from both factions in one table, led by the numbers that fold all
    the others together: full-stack Power and gold Efficiency, scored both for
    the body alone (Might) and with the essence it feeds your spells (Magic).
    Filter by faction, switch between base and upgraded tiers, and click any
    column to sort. Damage sorts by its average; offence and range sort by their
    best value.
  </p>
  <CompareTable client:load />
</Layout>
