---
import Layout from "@/layouts/Layout.astro";
import SpellBrowser from "@/components/SpellBrowser";
---

<Layout
  title="Spells"
  description="All Songs of Conquest spells — pure essence and dyad — with costs, durations and tier effects, filterable by school and faction affinity."
>
  <h1 class="text-3xl font-bold">Spells</h1>
  <p class="mt-2 mb-6 max-w-3xl text-muted-foreground">
    Every spell in the game with its essence cost, duration, and effect. Switch
    tiers to see how spells scale, filter by essence school, or show only the
    spells a faction's own troops can fuel.
  </p>
  <SpellBrowser client:load />
</Layout>
