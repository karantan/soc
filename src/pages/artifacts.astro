---
import Layout from "@/layouts/Layout.astro";
import ArtifactBrowser from "@/components/ArtifactBrowser";
import artifactsRaw from "@/data/artifacts.json";
import { changesFor, patchLabel } from "@/data/changelog";

const artifactPatches = Object.fromEntries(
	artifactsRaw
		.map((a) => [a.name, changesFor("artifact", [a.name]).map((c) => ({ label: patchLabel(c), text: c.text }))])
		.filter(([, notes]) => (notes as unknown[]).length > 0),
);
---

<Layout
  title="Artifacts"
  description="All Songs of Conquest artifacts with rarity, equipment slot, bonuses, penalties, set bonuses and lore."
  wide
>
  <h1 class="text-3xl font-bold">Artifacts</h1>
  <p class="mt-2 mb-6 max-w-3xl text-muted-foreground">
    Every artifact a wielder can carry, coloured by rarity. Filter by equipment
    slot or rarity, search by name or effect, and hover any artifact for its
    exact modifiers, set bonus and lore.
  </p>
  <ArtifactBrowser patches={artifactPatches} client:load />
</Layout>
