---
import Layout from "@/layouts/Layout.astro";
import { factions } from "@/data/factions";
import { factionStyles } from "@/data/factionStyles";
import unitsRaw from "@/data/units.json";
import abilityDescRaw from "@/data/abilityDescriptions.json";
import ResearchPanel from "@/components/ResearchPanel";
import researchRaw from "@/data/research.json";
import { researchByUnit, researchUnitMap } from "@/data/researchUnits";
import { growthOf, sizeOf } from "@/data/buildingTree";

const abilityDesc = abilityDescRaw as Record<string, string>;
const tokenTooltip = (val: string) =>
	val
		.split(/[,/]/)
		.map((s) => s.trim())
		.filter((s) => abilityDesc[s])
		.map((s) => `${s}: ${abilityDesc[s]}`)
		.join("\n") || undefined;

export function getStaticPaths() {
	return factions.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const faction = factions.find((f) => f.slug === slug);
if (!faction) throw new Error(`Unknown faction: ${slug}`);

const units = unitsRaw.filter((u) => u.faction === faction.name);

// Which unit each research applies to, resolved at build time so the client
// bundle doesn't need units.json / unitResearch.json.
const factionStacks = researchRaw
	.filter((r) => r.faction === faction.name)
	.flatMap((r) => r.stacks.map((s) => ({ ...s, building: r.building })));
const researchUnits = researchUnitMap(faction.name, factionStacks);
const unitResearch = researchByUnit(faction.name, factionStacks);

const RESOURCE_LABEL = (cost: Record<string, number>) =>
	Object.entries(cost)
		.map(([res, n]) => `${n} ${res}`)
		.join(", ");

const researchTooltip = (s: (typeof factionStacks)[number]) =>
	[
		`${s.name} — ${s.building}`,
		...s.levels.map(
			(lv, i) =>
				`${s.levels.length > 1 ? `Level ${i + 1}: ` : ""}${lv.effect}${
					Object.keys(lv.cost).length ? ` (${RESOURCE_LABEL(lv.cost)})` : ""
				}`,
		),
	].join("\n");

const accent = factionStyles[faction.name].text;
const borderAccent = factionStyles[faction.name].cardBorder.split(" ")[0];

// Settlement plot a unit's building occupies and how many troops it produces
// per round. The building string can carry a required-research suffix
// ("Barracks — Call on the Rangers"), so match on the building name alone.
const buildingInfo = (building: string) => {
	const name = building.split(" — ")[0].trim();
	return { size: sizeOf(name), growth: growthOf(name) };
};

const PLOT_BADGE: Record<string, string> = {
	Small: "border-border text-muted-foreground",
	Medium: "border-gold/40 text-gold/90",
	Large: "border-gold/70 bg-gold/10 text-gold",
};
const PLOT_DOT: Record<string, string> = {
	Small: "h-1.5 w-1.5",
	Medium: "h-2 w-2",
	Large: "h-2.5 w-2.5",
};

const RESOURCE_ICONS: Record<string, string> = {
	gold: "/images/units/icon-gold.jpg",
	amber: "/images/units/icon-amber.jpg",
	celestial: "/images/units/icon-celestial.jpg",
	glimmer: "/images/units/icon-glimmer.jpg",
};

const STAT_ROWS: [string, string][] = [
	["damage", "Damage"],
	["health", "Health"],
	["offence", "Offence"],
	["defence", "Defence"],
	["movement", "Movement"],
	["initiative", "Initiative"],
	["range", "Range"],
	["special", "Special"],
	["ability", "Ability"],
];
---

<Layout title={faction.name} description={faction.tagline}>
  <section class="py-6">
    <h1 class:list={["text-4xl md:text-5xl font-black", accent]}>{faction.name}</h1>
    <p class="mt-3 max-w-3xl text-lg italic text-muted-foreground">“{faction.tagline}”</p>

    <div class:list={["mt-6 rounded-lg border bg-card p-5 shadow-soft max-w-3xl", borderAccent]}>
      <h2 class="font-display text-sm uppercase tracking-wider text-gold">Magic Affinity</h2>
      <p class="mt-1 font-semibold">{faction.magicOrder.join(" › ")}</p>
      <p class="mt-2 text-sm text-muted-foreground">{faction.magicNotes}</p>
      <p class="mt-3 text-xs">
        <a href={faction.wikiUrl} class="underline text-muted-foreground hover:text-foreground">Full wiki page →</a>
      </p>
    </div>
  </section>

  <section class="py-4">
    <h2 class="text-2xl font-bold mb-3">Research</h2>
    <p class="mb-5 max-w-3xl text-sm text-muted-foreground">
      {faction.name}'s two research buildings. Unit-specific researches carry
      that unit's portrait. Hover a research to see its effect per level and
      cost.
    </p>
    <ResearchPanel faction={faction.name} units={researchUnits} client:load />
  </section>

  <section class="py-4">
    <div class="mb-5 flex items-baseline justify-between gap-3">
      <h2 class="text-2xl font-bold">Units</h2>
      <a href={`/buildings/#${faction.slug}`} class="text-sm underline text-muted-foreground hover:text-foreground">
        What each one costs to unlock →
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {units.map((u) => {
        const tiers = [
          { label: "Base", d: u.base },
          ...(u.upgraded ? [{ label: "Upgraded ★", d: u.upgraded }] : []),
          // Yulan lines upgrade into one of three house variants
          ...((u.upgrades ?? []).map((up) => ({ label: `${up.house} ★`, d: up }))),
        ];
        return (
          <article class:list={["rounded-lg border bg-card shadow-soft overflow-hidden", borderAccent]}>
            <header class="flex items-center justify-between border-b border-border/60 px-4 py-3">
              <h3 class="font-display font-bold">
                {u.base.name}
                {u.upgraded && <span class="text-muted-foreground font-normal"> → {u.upgraded.name}</span>}
                {u.upgrades && <span class="text-muted-foreground font-normal"> → {u.upgrades.map((x) => x.house).join(" / ")}</span>}
                {u.note && <span class="text-muted-foreground font-normal text-xs"> {u.note}</span>}
              </h3>
              <span class="flex items-center gap-2 text-xs text-muted-foreground whitespace-nowrap">
                {u.building}
                {buildingInfo(u.building).size && (
                  <span
                    class:list={[
                      "inline-flex items-center gap-1 rounded border px-1.5 py-0.5 font-display text-[10px] uppercase tracking-wider",
                      PLOT_BADGE[buildingInfo(u.building).size!],
                    ]}
                    title={`${buildingInfo(u.building).size} building plot`}
                  >
                    <span class:list={["inline-block rounded-[1px] bg-current", PLOT_DOT[buildingInfo(u.building).size!]]}></span>
                    {buildingInfo(u.building).size}
                  </span>
                )}
                {buildingInfo(u.building).growth && (
                  <span
                    class="inline-flex items-center rounded border border-border px-1.5 py-0.5 font-display text-[10px] uppercase tracking-wider tabular-nums"
                    title={`${u.building.split(" — ")[0]} produces ${buildingInfo(u.building).growth} per round (one round = one day)`}
                  >
                    +{buildingInfo(u.building).growth}/day
                  </span>
                )}
              </span>
            </header>
            <div class={`grid ${tiers.length >= 4 ? "grid-cols-2 lg:grid-cols-4" : tiers.length === 2 ? "grid-cols-2" : "grid-cols-1"} divide-x divide-border/60`}>
              {tiers.map((t) => (
                <div class="p-4">
                  <div class="flex items-center gap-3">
                    {t.d.image && (
                      <img
                        src={`/images/units/${t.d.image}`}
                        alt={t.d.name}
                        class="h-14 w-14 rounded border border-border object-cover"
                        loading="lazy"
                      />
                    )}
                    <div>
                      <p class="text-xs uppercase tracking-wider text-gold font-display">{t.label}</p>
                      <p class="font-semibold text-sm">{t.d.name}</p>
                      <span class="inline-flex gap-0.5 mt-0.5">
                        {t.d.essences.map((e) => (
                          <img src={`/images/units/icon-${e}.jpg`} alt={e} title={`${e} essence`} class="h-3.5 w-3.5 rounded-[2px]" />
                        ))}
                      </span>
                    </div>
                  </div>
                  <p class="mt-2 flex items-center gap-2 text-sm">
                    {Object.entries(t.d.cost).map(([res, n]) => (
                      <span class="inline-flex items-center gap-1">
                        {n}
                        {RESOURCE_ICONS[res]
                          ? <img src={RESOURCE_ICONS[res]} alt={res} title={res} class="h-3.5 w-3.5 rounded-[2px]" />
                          : <span class="text-xs text-muted-foreground">{res}</span>}
                      </span>
                    ))}
                    {Object.keys(t.d.cost).length === 0 && <span class="text-muted-foreground text-xs">summoned</span>}
                  </p>
                  <dl class="mt-3 space-y-1 text-xs">
                    {STAT_ROWS.map(([key, label]) => {
                      // biome-ignore lint/suspicious/noExplicitAny: dynamic stat lookup
                      const val = (t.d as any)[key] as string;
                      const tip = (key === "special" || key === "ability") ? tokenTooltip(val) : undefined;
                      return val ? (
                        <div class="flex justify-between gap-2">
                          <dt class="text-muted-foreground">{label}</dt>
                          <dd
                            class:list={["text-right font-medium tabular-nums", tip && "cursor-help underline decoration-dotted decoration-muted-foreground/60 underline-offset-2"]}
                            title={tip}
                          >{val}</dd>
                        </div>
                      ) : null;
                    })}
                    <div class="flex justify-between gap-2">
                      <dt class="text-muted-foreground">Max troop</dt>
                      <dd class="text-right font-medium tabular-nums">{(t.d as any).maxTroopSize ?? u.maxTroopSize}</dd>
                    </div>
                  </dl>
                </div>
              ))}
            </div>
            {(unitResearch[u.base.name] ?? []).length > 0 && (
              <footer class="border-t border-border/60 px-4 py-3">
                <p class="mb-1.5 font-display text-[11px] uppercase tracking-wider text-muted-foreground">Research</p>
                <div class="flex flex-wrap gap-1.5">
                  {unitResearch[u.base.name].map((s) => (
                    <span
                      class="inline-flex cursor-help items-center gap-1.5 rounded border border-border bg-secondary px-2 py-1 text-xs transition-colors hover:border-gold/60"
                      title={researchTooltip(s)}
                    >
                      {s.name}
                      {s.levels.length > 1 && <span class="text-[10px] text-muted-foreground">×{s.levels.length}</span>}
                      <span class="text-[10px] text-muted-foreground">{s.building}</span>
                    </span>
                  ))}
                </div>
              </footer>
            )}
          </article>
        );
      })}
    </div>
  </section>
</Layout>
