---
import Layout from "@/layouts/Layout.astro";
import { factions } from "@/data/factions";
import { factionStyles } from "@/data/factionStyles";
import unitsRaw from "@/data/units.json";
import abilityDescRaw from "@/data/abilityDescriptions.json";
import ResearchPanel from "@/components/ResearchPanel";
import StatDelta from "@/components/StatDelta.astro";
import researchRaw from "@/data/research.json";
import { researchByUnit, researchUnitMap } from "@/data/researchUnits";
import { growthOfUnit, producerOf, sizeOf } from "@/data/buildingTree";
import { changelogSource, changesFor, factionChanges, patchLabel } from "@/data/changelog";
import {
	BAND_CLASS,
	BAND_LABEL,
	BUILD_BLURB,
	BUILD_LABEL,
	BUILDS,
	bandOf,
	berserkNote,
	powerOf,
} from "@/data/unitPower";

const abilityDesc = abilityDescRaw as Record<string, string>;

export function getStaticPaths() {
	return factions.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const faction = factions.find((f) => f.slug === slug);
if (!faction) throw new Error(`Unknown faction: ${slug}`);

const units = unitsRaw.filter((u) => u.faction === faction.name);

// Which unit each research applies to, resolved at build time so the client
// bundle doesn't need units.json / unitResearch.json.
const factionStacks = researchRaw
	.filter((r) => r.faction === faction.name)
	.flatMap((r) => r.stacks.map((s) => ({ ...s, building: r.building })));
const researchUnits = researchUnitMap(faction.name, factionStacks);
const unitResearch = researchByUnit(faction.name, factionStacks);

const RESOURCE_LABEL = (cost: Record<string, number>) =>
	Object.entries(cost)
		.map(([res, n]) => `${n} ${res}`)
		.join(", ");

const researchTooltip = (s: (typeof factionStacks)[number]) =>
	[
		`${s.name} — ${s.building}`,
		...s.levels.map(
			(lv, i) =>
				`${s.levels.length > 1 ? `Level ${i + 1}: ` : ""}${lv.effect}${
					Object.keys(lv.cost).length ? ` (${RESOURCE_LABEL(lv.cost)})` : ""
				}`,
		),
	].join("\n");

const accent = factionStyles[faction.name].text;
const borderAccent = factionStyles[faction.name].cardBorder.split(" ")[0];

// Settlement plot a unit's building occupies and how many troops it produces
// per round. The building string can carry a required-research suffix
// ("Barracks — Call on the Rangers"), so match on the building name alone.
const buildingInfo = (building: string, unitName: string) => {
	const name = building.split(" — ")[0].trim();
	// The growth belongs to the unit, not the building: an improvement-gated
	// line produces on its own track, so asking the building would report what
	// its base tier makes instead.
	return {
		size: sizeOf(name),
		growth: growthOfUnit(unitName),
		improved: producerOf(unitName)?.improved ?? false,
	};
};

const PLOT_BADGE: Record<string, string> = {
	Small: "border-border text-muted-foreground",
	Medium: "border-gold/40 text-gold/90",
	Large: "border-gold/70 bg-gold/10 text-gold",
};
const PLOT_DOT: Record<string, string> = {
	Small: "h-1.5 w-1.5",
	Medium: "h-2 w-2",
	Large: "h-2.5 w-2.5",
};

// Patch history: a unit line collects changes naming any of its tiers.
const tierNames = (u: (typeof units)[number]) =>
	[u.base.name, u.upgraded?.name, ...(u.upgrades ?? []).map((x) => x.name)].filter(
		(n): n is string => Boolean(n),
	);
const patchesFor = (u: (typeof units)[number]) => changesFor("unit", tierNames(u));
const factionPatches = factionChanges(
	faction.name,
	units.flatMap(tierNames),
	[...new Set(units.map((u) => u.building.split(" — ")[0].trim()))],
);

const RESOURCE_ICONS: Record<string, string> = {
	gold: "/images/units/icon-gold.jpg",
	amber: "/images/units/icon-amber.jpg",
	celestial: "/images/units/icon-celestial.jpg",
	glimmer: "/images/units/icon-glimmer.jpg",
};

// Every number a stat string carries: "2-3" -> [2, 3], "10/25" -> [10, 25].
const statNums = (v: string) => (v.match(/\d+/g) ?? []).map(Number);

/**
 * How an upgraded tier's stat compares with the base tier's. Averaged rather
 * than compared component-wise so a damage range ("2-3" -> "4-7") and a paired
 * stat ("10/25" melee/ranged) both reduce to one honest direction. Every
 * numeric stat on this card is better when higher, so no per-stat polarity.
 */
const statDelta = (base: string | undefined, val: string | undefined) => {
	if (!val) return null;
	if (!base) return { gained: true } as const;
	if (base === val) return null;
	const a = statNums(base);
	const b = statNums(val);
	if (!a.length || !b.length) return null;
	const mean = (xs: number[]) => xs.reduce((x, y) => x + y, 0) / xs.length;
	const d = mean(b) - mean(a);
	if (!d) return null;
	return {
		up: d > 0,
		amount: Math.round(Math.abs(d) * 10) / 10,
		from: base,
	} as const;
};

/**
 * Split a Special/Ability list into its parts, each carrying its own
 * description for the hover and a flag for the ones this tier gained (the
 * colour says "new", so the tooltip is free to explain what the ability does).
 * Separators are kept so the value still reads as it was written.
 */
const abilityParts = (base: string | undefined, val: string) => {
	const had = new Set(
		(base ?? "")
			.split(/[,/]/)
			.map((t) => t.trim())
			.filter(Boolean),
	);
	return val.split(/([,/])/).map((part) => {
		const token = part.trim();
		const isToken = Boolean(token) && !/^[,/]$/.test(part);
		return {
			part,
			token,
			desc: isToken ? abilityDesc[token] : undefined,
			gained: isToken && base !== undefined && !had.has(token),
		};
	});
};

const STAT_ROWS: [string, string][] = [
	["damage", "Damage"],
	["health", "Health"],
	["offence", "Offence"],
	["defence", "Defence"],
	["movement", "Movement"],
	["initiative", "Initiative"],
	["range", "Range"],
	["special", "Special"],
	["ability", "Ability"],
];
---

<Layout title={faction.name} description={faction.tagline}>
  <section class="py-6">
    <h1 class:list={["text-4xl md:text-5xl font-black", accent]}>{faction.name}</h1>
    <p class="mt-3 max-w-3xl text-lg italic text-muted-foreground">“{faction.tagline}”</p>

    <div class:list={["mt-6 rounded-lg border bg-card p-5 shadow-soft max-w-3xl", borderAccent]}>
      <h2 class="font-display text-sm uppercase tracking-wider text-gold">Magic Affinity</h2>
      <p class="mt-1 font-semibold">{faction.magicOrder.join(" › ")}</p>
      <p class="mt-2 text-sm text-muted-foreground">{faction.magicNotes}</p>
      <p class="mt-3 text-xs">
        <a href={faction.wikiUrl} class="underline text-muted-foreground hover:text-foreground">Full wiki page →</a>
      </p>
    </div>
  </section>

  <section class="py-4">
    <h2 class="text-2xl font-bold mb-3">Research</h2>
    <p class="mb-5 max-w-3xl text-sm text-muted-foreground">
      {faction.name}'s two research buildings. Unit-specific researches carry
      that unit's portrait. Hover a research to see its effect per level and
      cost.
    </p>
    <ResearchPanel faction={faction.name} units={researchUnits} client:load />
  </section>

  {factionPatches.length > 0 && (
    <section class="py-4">
      <div class="mb-3 flex items-baseline justify-between gap-3">
        <h2 class="text-2xl font-bold">Patch history</h2>
        <span class="flex items-center gap-3 text-sm">
          <a
            href={changelogSource}
            class="underline decoration-dotted text-muted-foreground hover:text-gold"
            target="_blank"
            rel="noopener noreferrer"
          >Official archive ↗</a>
          <a href="/patches/" class="underline text-muted-foreground hover:text-foreground">
            All patch notes →
          </a>
        </span>
      </div>
      <p class="mb-4 max-w-3xl text-sm text-muted-foreground">
        Every change the developers logged for {faction.name}, its units and its
        buildings — the buffs and nerfs behind what people say is strong.
      </p>
      <ul class="max-w-4xl space-y-1.5 text-sm">
        {factionPatches.slice(0, 12).map((c) => (
          <li class="flex gap-2">
            <span class="shrink-0 font-semibold tabular-nums text-gold/80">{patchLabel(c)}</span>
            <span class="text-muted-foreground">{c.text}</span>
          </li>
        ))}
      </ul>
      {factionPatches.length > 12 && (
        <details class="mt-2 max-w-4xl">
          <summary class="cursor-pointer text-sm text-muted-foreground hover:text-foreground">
            {factionPatches.length - 12} older changes
          </summary>
          <ul class="mt-2 space-y-1.5 text-sm">
            {factionPatches.slice(12).map((c) => (
              <li class="flex gap-2">
                <span class="shrink-0 font-semibold tabular-nums text-gold/80">{patchLabel(c)}</span>
                <span class="text-muted-foreground">{c.text}</span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
  )}

  <section class="py-4">
    <div class="mb-3 flex items-baseline justify-between gap-3">
      <h2 class="text-2xl font-bold">Units</h2>
      <a href={`/buildings/#${faction.slug}`} class="text-sm underline text-muted-foreground hover:text-foreground">
        What each one costs to unlock →
      </a>
    </div>
    <p class="mb-5 max-w-3xl text-sm text-muted-foreground">
      Each tier leads with its <span class="font-semibold text-gold">Power / Efficiency</span> —
      Power is a full-stack combat score, Efficiency is Power per gold, and
      they are scored twice: <span class="font-semibold text-foreground/90">Might</span>
      for the body alone, <span class="font-semibold text-foreground/90">Magic</span>
      with the essence it feeds your spells. Scores are coloured by rank within
      the unit's role — yellow through green above the median (green = top 10%),
      orange and red below. These are the Codex-adjusted scores, built on
      the community
      <a
        href="https://steamcommunity.com/app/867210/discussions/0/563659290304345947/"
        class="underline decoration-dotted hover:text-gold"
        target="_blank"
        rel="noopener noreferrer"
      >Unit Comparison v4</a> sheet — see the
      <a href="/power-model/" class="underline hover:text-gold">Power Model page</a>
      for what changed, or
      <a href="/compare/" class="underline hover:text-gold">rank every unit →</a>
    </p>
    <div class="grid gap-5 md:grid-cols-2">
      {units.map((u) => {
        const tiers = [
          { label: "Base", d: u.base },
          ...(u.upgraded ? [{ label: "Upgraded ★", d: u.upgraded }] : []),
          // Yulan lines upgrade into one of three house variants
          ...((u.upgrades ?? []).map((up) => ({ label: `${up.house} ★`, d: up }))),
        ];
        return (
          <article class:list={["rounded-lg border bg-card shadow-soft overflow-hidden", borderAccent]}>
            <header class="flex items-center justify-between border-b border-border/60 px-4 py-3">
              <h3 class="font-display font-bold">
                {u.base.name}
                {u.upgraded && <span class="text-muted-foreground font-normal"> → {u.upgraded.name}</span>}
                {u.upgrades && <span class="text-muted-foreground font-normal"> → {u.upgrades.map((x) => x.house).join(" / ")}</span>}
                {u.note && <span class="text-muted-foreground font-normal text-xs"> {u.note}</span>}
              </h3>
              <span class="flex items-center gap-2 text-xs text-muted-foreground whitespace-nowrap">
                {u.building}
                {buildingInfo(u.building, u.base.name).size && (
                  <span
                    class:list={[
                      "inline-flex items-center gap-1 rounded border px-1.5 py-0.5 font-display text-[10px] uppercase tracking-wider",
                      PLOT_BADGE[buildingInfo(u.building, u.base.name).size!],
                    ]}
                    data-tip={`This unit is produced by a building on a ${buildingInfo(u.building, u.base.name).size!.toLowerCase()} settlement plot.`}
                    data-tip-title="Building plot"
                  >
                    <span class:list={["inline-block rounded-[1px] bg-current", PLOT_DOT[buildingInfo(u.building, u.base.name).size!]]}></span>
                    {buildingInfo(u.building, u.base.name).size}
                  </span>
                )}
                {buildingInfo(u.building, u.base.name).growth && (
                  <span
                    class="inline-flex items-center rounded border border-border px-1.5 py-0.5 font-display text-[10px] uppercase tracking-wider tabular-nums"
                    data-tip={buildingInfo(u.building, u.base.name).improved
                      ? `${u.building.split(" — ")[0]} produces ${buildingInfo(u.building, u.base.name).growth} ${u.base.name} per round once the ${u.building.split(" — ")[1]} improvement is built (one round = one day).`
                      : `${u.building.split(" — ")[0]} produces ${buildingInfo(u.building, u.base.name).growth} per round (one round = one day).`}
                    data-tip-title="Troop growth"
                  >
                    +{buildingInfo(u.building, u.base.name).growth}/day
                  </span>
                )}
              </span>
            </header>
            <div class={`grid ${tiers.length >= 4 ? "grid-cols-2 lg:grid-cols-4" : tiers.length === 2 ? "grid-cols-2" : "grid-cols-1"} divide-x divide-border/60`}>
              {tiers.map((t, tierIndex) => {
                const score = powerOf(faction.name, t.d.name);
                // biome-ignore lint/suspicious/noExplicitAny: dynamic stat lookup
                const base = tierIndex === 0 ? null : (tiers[0].d as any);
                return (
                <div class="p-4">
                  <div class="flex items-center gap-3">
                    {t.d.image && (
                      <img
                        src={`/images/units/${t.d.image}`}
                        alt={t.d.name}
                        class="h-14 w-14 rounded border border-border object-cover"
                        loading="lazy"
                      />
                    )}
                    <div>
                      <p class="text-xs uppercase tracking-wider text-gold font-display">{t.label}</p>
                      <p class="font-semibold text-sm">{t.d.name}</p>
                      <span class="inline-flex gap-0.5 mt-0.5">
                        {t.d.essences.map((e) => (
                          <img src={`/images/units/icon-${e}.jpg`} alt={e} title={`${e} essence`} class="h-3.5 w-3.5 rounded-[2px]" />
                        ))}
                      </span>
                    </div>
                  </div>
                  <p class="mt-2 flex items-center gap-2 text-sm">
                    {Object.entries(t.d.cost).map(([res, n]) => (
                      <span class="inline-flex items-center gap-1">
                        {n}
                        {RESOURCE_ICONS[res]
                          ? <img src={RESOURCE_ICONS[res]} alt={res} title={res} class="h-3.5 w-3.5 rounded-[2px]" />
                          : <span class="text-xs text-muted-foreground">{res}</span>}
                      </span>
                    ))}
                    {Object.keys(t.d.cost).length === 0 && <span class="text-muted-foreground text-xs">summoned</span>}
                  </p>
                  {score && (
                    <div class="mt-3 rounded border border-gold/30 bg-gold/5 px-2 py-1.5">
                      <p
                        class="font-display text-[9px] uppercase tracking-widest text-gold/70"
                        data-tip="Power is a full-stack combat score for the whole stack; Efficiency is that Power per gold of stack cost."
                        data-tip-title="Power / Efficiency"
                      >
                        Power / Eff
                      </p>
                      <dl class="mt-0.5">
                        {BUILDS.map((b) => {
                          const r = score.adj[b];
                          const powerBand = bandOf(score, "adj", b, "power");
                          const effBand = bandOf(score, "adj", b, "eff");
                          const berserk = berserkNote(score, "adj", b);
                          return (
                            <div class="flex items-baseline justify-between gap-2" data-tip={BUILD_BLURB[b]} data-tip-title={`${BUILD_LABEL[b]} scoring`}>
                              <dt class="font-display text-[10px] uppercase tracking-wider text-gold/90">
                                {BUILD_LABEL[b]}
                              </dt>
                              <dd class="whitespace-nowrap tabular-nums">
                                {r ? (
                                  <>
                                    <span
                                      class:list={[powerBand ? BAND_CLASS[powerBand] : "font-bold"]}
                                      data-tip={powerBand
                                        ? `${r.power} — ${BAND_LABEL[powerBand]} of ${score.role} units.`
                                        : "Full-stack combat strength."}
                                      data-tip-title={`${BUILD_LABEL[b]} Power`}
                                    >{r.power}</span>
                                    <span class="mx-0.5 text-muted-foreground/60">/</span>
                                    <span
                                      class:list={[effBand ? BAND_CLASS[effBand] : "font-bold"]}
                                      data-tip={effBand
                                        ? `${r.eff} — ${BAND_LABEL[effBand]} of ${score.role} units.`
                                        : "Power per gold of stack cost."}
                                      data-tip-title={`${BUILD_LABEL[b]} Efficiency`}
                                    >{r.eff}</span>
                                    {berserk && <sup class="ml-0.5 text-[9px] text-gold" data-tip={berserk} data-tip-title="Berserker">B</sup>}
                                  </>
                                ) : <span class="text-muted-foreground">—</span>}
                              </dd>
                            </div>
                          );
                        })}
                      </dl>
                    </div>
                  )}
                  <dl class="mt-3 space-y-1 text-xs">
                    {STAT_ROWS.map(([key, label]) => {
                      // biome-ignore lint/suspicious/noExplicitAny: dynamic stat lookup
                      const val = (t.d as any)[key] as string;
                      const text = key === "special" || key === "ability";
                      const prev = base ? (base[key] as string) : undefined;
                      const delta = base && !text ? statDelta(prev, val) : null;
                      return val ? (
                        <div class="flex justify-between gap-2">
                          <dt class="text-muted-foreground">{label}</dt>
                          <dd class="text-right font-medium tabular-nums">
                            {text
                              ? abilityParts(prev, val).map((p) => (
                                  <span
                                    class:list={[
                                      p.gained && "font-semibold text-gold",
                                      p.desc && "underline decoration-dotted decoration-muted-foreground/60 underline-offset-2",
                                    ]}
                                    data-tip={p.desc}
                                    data-tip-title={p.desc ? p.token : undefined}
                                  >{p.part}</span>
                                ))
                              : val}
                            <StatDelta delta={delta} label={label} />
                          </dd>
                        </div>
                      ) : null;
                    })}
                    {(() => {
                      const val = String((t.d as any).maxTroopSize ?? u.maxTroopSize);
                      const prev = base ? String(base.maxTroopSize ?? u.maxTroopSize) : undefined;
                      return (
                        <div class="flex justify-between gap-2">
                          <dt class="text-muted-foreground">Max troop</dt>
                          <dd class="text-right font-medium tabular-nums">
                            {val}
                            <StatDelta delta={base ? statDelta(prev, val) : null} label="Max troop" />
                          </dd>
                        </div>
                      );
                    })()}
                  </dl>
                </div>
                );
              })}
            </div>
            {patchesFor(u).length > 0 && (
              <details class="border-t border-border/60 px-4 py-3">
                <summary class="cursor-pointer font-display text-[11px] uppercase tracking-wider text-muted-foreground hover:text-foreground">
                  Patch history ({patchesFor(u).length})
                </summary>
                <ul class="mt-2 space-y-1.5 text-xs">
                  {patchesFor(u).map((c) => (
                    <li class="flex gap-2">
                      <span class="shrink-0 font-semibold tabular-nums text-gold/80">{patchLabel(c)}</span>
                      <span class="text-muted-foreground">{c.text}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-2 text-[11px] text-muted-foreground/80">
                  Quoted from the
                  <a
                    href={changelogSource}
                    class="underline decoration-dotted hover:text-gold"
                    target="_blank"
                    rel="noopener noreferrer"
                  >official changelog archive ↗</a>
                </p>
              </details>
            )}
            {(unitResearch[u.base.name] ?? []).length > 0 && (
              <footer class="border-t border-border/60 px-4 py-3">
                <p class="mb-1.5 font-display text-[11px] uppercase tracking-wider text-muted-foreground">Research</p>
                <div class="flex flex-wrap gap-1.5">
                  {unitResearch[u.base.name].map((s) => (
                    <span
                      class="inline-flex cursor-help items-center gap-1.5 rounded border border-border bg-secondary px-2 py-1 text-xs transition-colors hover:border-gold/60"
                      data-tip={researchTooltip(s)}
                    >
                      {s.name}
                      {s.levels.length > 1 && <span class="text-[10px] text-muted-foreground">×{s.levels.length}</span>}
                      <span class="text-[10px] text-muted-foreground">{s.building}</span>
                    </span>
                  ))}
                </div>
              </footer>
            )}
          </article>
        );
      })}
    </div>
  </section>
</Layout>
