---
import Layout from "@/layouts/Layout.astro";
import { factions } from "@/data/factions";
import { factionStyles } from "@/data/factionStyles";
import units from "@/data/units.json";

const unitCount = (name: string) => units.filter((u) => u.faction === name).length;
// last four units with images per faction (higher-tier units sit at the end of each roster)
const heroUnits = (name: string) =>
	units
		.filter((u) => u.faction === name)
		.map((u) => u.upgraded?.image ?? u.base.image)
		.filter((img): img is string => Boolean(img))
		.slice(-5, -1);
---

<Layout>
  <section class="py-10 text-center">
    <p class="font-display text-sm uppercase tracking-[0.3em] text-gold">Songs of Conquest</p>
    <h1 class="mt-3 text-4xl md:text-6xl font-black">Faction Codex</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
      Unit rosters, stats and spells for all seven factions of Aerbor —
      side by side, sortable, and searchable.
    </p>
    <div class="mt-8">
      <a
        href="/compare/"
        class="inline-block rounded-md bg-primary px-6 py-3 font-display font-bold text-primary-foreground shadow-medium transition-transform hover:scale-105"
      >
        Compare Unit Stats →
      </a>
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-2 py-8">
    {factions.map((f) => (
      <a
        href={`/factions/${f.slug}/`}
        class:list={[
          "group rounded-lg border bg-card p-6 shadow-soft transition-all hover:shadow-medium hover:-translate-y-0.5",
          factionStyles[f.name].cardBorder,
        ]}
      >
        <div class="flex items-center justify-between">
          <h2 class:list={["text-2xl font-bold", factionStyles[f.name].text]}>
            {f.name}
          </h2>
          <span class="text-xs text-muted-foreground">{unitCount(f.name)} units</span>
        </div>
        <p class="mt-2 text-sm text-muted-foreground italic">“{f.tagline}”</p>
        <div class="mt-4 flex gap-2">
          {heroUnits(f.name).map((img) => (
            <img
              src={`/images/units/${img}`}
              alt=""
              class="h-16 w-16 rounded border border-border object-cover transition-transform group-hover:scale-105"
              loading="lazy"
            />
          ))}
        </div>
        <p class="mt-4 text-xs text-muted-foreground">
          Magic affinity: {f.magicOrder.join(" › ")}
        </p>
      </a>
    ))}
  </section>
</Layout>
